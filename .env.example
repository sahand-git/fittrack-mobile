# Server only. Never prefix Gemini/Admin secrets with VITE_ or put them in mobile assets.
NODE_ENV=development
PORT=3000
FIREBASE_PROJECT_ID=
# Local development only: path to a service-account file OUTSIDE the repository.
# On hosting, prefer the platform service identity/Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Include deployed web origin and only native origins actually used by this app.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,http://localhost,https://localhost
AI_USER_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=500
AI_USER_MINUTE_LIMIT=4
AI_GLOBAL_MINUTE_LIMIT=30
AI_MAX_PROMPT_CHARS=24000
AI_MAX_IMAGE_BYTES=4194304
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_OUTPUT_CHARS=32000
AI_TIMEOUT_MS=30000
# Public client API origin; leave empty for same-origin web. Native requires deployed HTTPS API.
VITE_API_ORIGIN=

