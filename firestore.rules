rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /fitnessBackups/{userId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId
          && request.auth.token.email_verified == true;
      }
      function validBackup() {
        let data = request.resource.data;
        return data.keys().hasOnly(['schemaVersion', 'revision', 'payload', 'updatedAt'])
          && data.keys().hasAll(['schemaVersion', 'revision', 'payload', 'updatedAt'])
          && data.schemaVersion == 1
          && data.revision is int && data.revision > 0
          && data.payload is string && data.payload.size() > 0 && data.payload.size() <= 750000
          && data.updatedAt == request.time;
      }
      allow get: if owner();
      allow create: if owner() && validBackup() && request.resource.data.revision == 1;
      allow update: if owner() && validBackup()
        && request.resource.data.revision == resource.data.revision + 1;
      allow list, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
